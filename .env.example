# Copy to .env and fill in. Dev values only; never commit real secrets.

# HMAC secret for the csrfToken cookie, at least 32 characters.
CSRF_SECRET=change-me-change-me-change-me-0123456789

# The single SPA origin allowed by the CSRF Origin check (Kong CORS origin is set in kong/kong.yml).
SPA_ORIGIN=http://localhost:8080

# Page in the SPA that receives the reset token; the email link is this URL plus ?token=...
RESET_LINK_BASE_URL=http://localhost:5173/reset-password

# First Admin account, created at startup if no user has this email.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=P@ssw0rd!

# SMTP for the forgot-password email (Mailtrap sandbox or Gmail). Leave empty to skip sending.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=xxx
SMTP_PASSWORD=xxx
SMTP_CRYPTO=tls
SMTP_FROM_ADDRESS=no-reply@example.com
