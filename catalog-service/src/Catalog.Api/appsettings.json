{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": "Data Source=catalog.db"
  },
  "Jwt": {
    "Issuer": "auth-service",
    "PublicKeyPath": ""
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "kafka:9092",
    "GroupId": "catalog-service",
    "MaxAttempts": 3,
    "RetryDelayMs": 500,
    "RelayIntervalSeconds": 1
  }
}
